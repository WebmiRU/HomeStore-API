FROM php:8.5-fpm

# nginx + supervisor + php extensions + build tools
RUN rm -f /etc/apt/sources.list.d/*.sources \
    && printf 'deb [trusted=yes] https://deb.debian.org/debian trixie main\ndeb [trusted=yes] https://deb.debian.org/debian trixie-updates main\ndeb [trusted=yes] https://deb.debian.org/debian-security trixie-security main\n' > /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        git \
        unzip \
        curl \
        libpq-dev \
        libzip-dev \
        libonig-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
    && export CFLAGS="-O0 -g0" CXXFLAGS="-O0 -g0" \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j1 \
        pdo_pgsql \
        pgsql \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        zip \
        gd \
    && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Application code
COPY . /var/www/html
WORKDIR /var/www/html

# PHP dependencies
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader

# nginx site config (fastcgi to local php-fpm)
COPY .kube/nginx/prod.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

# php-fpm + nginx under supervisor
RUN echo -e "[supervisord]\nnodaemon=true\n\n[program:php-fpm]\ncommand=php-fpm\nautostart=true\nautorestart=true\n\n[program:nginx]\ncommand=nginx -g 'daemon off;'\nautostart=true\nautorestart=true" > /etc/supervisor/conf.d/supervisord.conf

# writable dirs
RUN mkdir -p storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && php artisan config:clear 2>/dev/null || true

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
